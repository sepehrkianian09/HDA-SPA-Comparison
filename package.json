{
  "name": "spa-hda-experiment",
  "version": "1.0.0",
  "private": true,
  "description": "A controlled comparison of React SPA and htmx HDA shopping flows",
  "scripts": {
    "start": "node step-6-applications/backend/server.js",
    "test": "node --test step-6-applications/backend/*.test.js",
    "test:e2e": "playwright test --config=step-6-applications/e2e/playwright.config.js",
    "metrics": "node step-7-metrics/scripts/collect-maintainability.js",
    "metrics:compare": "node step-7-metrics/scripts/compare-metrics.js",
    "metrics:ui": "node step-7-metrics/scripts/collect-ui-metrics.js",
    "metrics:ui:spa": "UI_TARGET=spa node step-7-metrics/scripts/collect-ui-metrics.js",
    "metrics:ui:hda": "UI_TARGET=hda node step-7-metrics/scripts/collect-ui-metrics.js"
  }
}
